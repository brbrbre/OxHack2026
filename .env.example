# Copy this file to .env and add your keys. .env is never committed.

# Gemini: "In short" summary, "Ask Horizon" tutor and the reminder text
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ElevenLabs: "Listen" and the reminder call
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=   (optional; leave commented to use the default voice)
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Tiger Data: prices and graded predictions (optional)
TIGER_DATABASE_URL=

# Model: tda (default) or xgboost; TDA_PARAMS picks the trained parameters
MODELO=tda
TDA_PARAMS=model/params_tda.json

# Twilio: WhatsApp (sandbox) and the call
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=

# Make it a habit
PUBLIC_URL=http://localhost:8000
DEMO_PHONE=
HABITO_PERMITIDOS=
HABITO_LLAMADA_A=
HABITO_CANAL=whatsapp
HABITO_ESPERA_MIN=1440
HABITO_DEMO=0
HABITO_AUTO=0
